--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 81179c4a4b194bdfa2bae51381b7ccc2, type: 3}
  m_Name: TutorialLessons
  m_EditorClassIdentifier: 
  lessons:
  - step: 1
    title: "\u9759\u6B62\u578B\u5F71\u5B50"
    instruction: "\u6309 E\uFF0C\u5F00\u59CB\u51C6\u5907\u5F71\u5B50\u3002"
    recordingInstruction: "\u4FDD\u6301\u4E0D\u52A8\uFF0C\u518D\u6309 E \u7ED3\u675F\u3002"
  - step: 2
    title: "\u6D88\u9664\u5F71\u5B50"
    instruction: "\u6309\u6570\u5B57\u952E\u9009\u4E2D\u5F71\u5B50\uFF0C\u518D\u6309\u4E00\u6B21
      R\u3002"
    recordingInstruction: 
  - step: 3
    title: "\u8DDF\u968F\u578B\u5F71\u5B50"
    instruction: "\u6309 E\uFF0C\u51C6\u5907\u7559\u4E0B\u8DDF\u968F\u578B\u5F71\u5B50\u3002"
    recordingInstruction: "\u5148\u79FB\u52A8\uFF0C\u518D\u505C\u4F4F\u534A\u79D2\uFF0C\u6309
      E \u7ED3\u675F\u3002"
  - step: 4
    title: "\u89C2\u5BDF\u8DDF\u968F"
    instruction: "\u5411\u5DE6\u3001\u5411\u53F3\u79FB\u52A8\uFF0C\u518D\u6309\u7A7A\u683C\u8DF3\u8DC3\u3002"
    recordingInstruction: 
  - step: 5
    title: "\u907F\u8BA9\u578B\u5F71\u5B50"
    instruction: "\u6309 E\uFF0C\u51C6\u5907\u7559\u4E0B\u907F\u8BA9\u578B\u5F71\u5B50\u3002"
    recordingInstruction: "\u5148\u5411\u53F3\uFF0C\u518D\u5411\u5DE6\uFF0C\u6309
      E \u7ED3\u675F\u3002"
  - step: 6
    title: "\u89C2\u5BDF\u907F\u8BA9"
    instruction: "\u89C2\u5BDF\u5F71\u5B50\u78B0\u5230\u969C\u788D\u540E\u8F6C\u5411\u3002"
    recordingInstruction: 
  - step: 7
    title: "\u6E05\u9664\u5168\u90E8"
    instruction: "\u5FEB\u901F\u6309\u4E24\u6B21 R\uFF0C\u6E05\u9664\u6240\u6709\u5F71\u5B50\u3002"
    recordingInstruction: 
  - step: 8
    title: "\u8D8B\u8FD1\u578B\u5F71\u5B50"
    instruction: "\u6309 E\uFF0C\u51C6\u5907\u7559\u4E0B\u8D8B\u8FD1\u578B\u5F71\u5B50\u3002"
    recordingInstruction: "\u6309\u4F4F D \u5411\u53F3\u79FB\u52A8\uFF0C\u540C\u65F6\u6309
      E \u7ED3\u675F\u3002"
  - step: 9
    title: "\u5F71\u5B50\u4E5F\u662F\u843D\u811A\u70B9"
    instruction: "\u501F\u52A9\u77EE\u53F0\uFF0C\u8DF3\u5230\u505C\u6B62\u7684\u5F71\u5B50\u5934\u9876\u3002"
    recordingInstruction: 
  - step: 10
    title: "\u5F71\u5B50\u63A2\u8DEF"
    instruction: "\u8D70\u5230 \u25BC \u6807\u8BB0\u5904\uFF0C\u6309 E \u51C6\u5907\u3002"
    recordingInstruction: "\u6309\u4F4F D\uFF0C\u7ACB\u5373\u6309 E\uFF0C\u7559\u4E0B\u671D\u53F3\u7684\u5F71\u5B50\u3002"
  - step: 11
    title: "\u89C2\u5BDF\u5730\u523A"
    instruction: "\u7559\u5728\u5B89\u5168\u5730\u9762\uFF0C\u89C2\u5BDF\u5F71\u5B50\u63A5\u89E6\u5730\u523A\u3002"
    recordingInstruction: 
  - step: 12
    title: "\u75BE\u884C\u8DF3\u8DC3"
    instruction: "\u6309\u4F4F D + Shift \u75BE\u884C\uFF0C\u5728\u8FB9\u7F18\u524D\u6309\u7A7A\u683C\u3002"
    recordingInstruction: 
  - step: 13
    title: "\u65D7\u5E1C\u673A\u5173"
    instruction: "\u8BA9\u5F71\u5B50\u8E29\u4F4F\u5E26\u65D7\u5E1C\u7684\u673A\u5173\u3002"
    recordingInstruction: 
  - step: 14
    title: "\u8DEF\u706F\u5B58\u6863"
    instruction: "\u8BA9\u5F71\u5B50\u89E6\u78B0\u8DEF\u706F\uFF0C\u70B9\u4EAE\u540E\u5373\u53EF\u5B58\u6863\u3002"
    recordingInstruction: 
  - step: 15
    title: "\u8FD4\u56DE\u4E0E\u7EED\u884C"
    instruction: "\u6309 Q \u8FD4\u56DE\u83DC\u5355\uFF0C\u9009\u62E9\u201C\u7EED\u884C\u201D\u56DE\u5230\u8FD9\u91CC\u3002"
    recordingInstruction: 
  - step: 16
    title: "\u8C03\u6574\u89C6\u91CE"
    instruction: "\u6EDA\u52A8\u9F20\u6807\u6EDA\u8F6E\uFF1A\u5411\u4E0B\u62C9\u8FDC\uFF0C\u5411\u4E0A\u62C9\u8FD1\u3002"
    recordingInstruction: 
  - step: 17
    title: "\u5F00\u59CB\u63A2\u7D22"
    instruction: "\u591A\u591A\u89C2\u5BDF\uFF0C\u624D\u80FD\u987A\u5229\u901A\u5173\u3002\u52A0\u6CB9\uFF01"
    recordingInstruction: 
  preparingFormat: "\u51C6\u5907\u4E2D \xB7 {time} \u79D2\uFF08E \u53D6\u6D88\uFF09"
  recordingFormat: "\u8BB0\u5F55\u4E2D \xB7 {time} \u79D2"
  needTwoShadows: "\u518D\u751F\u6210\u4E00\u4E2A\u5F71\u5B50\uFF0C\u518D\u5FEB\u901F\u6309\u4E24\u6B21
    R\u3002"
  approachWatching: "\u89C2\u5BDF\u5F71\u5B50\uFF1A\u9047\u5230\u969C\u788D\u540E\uFF0C\u5B83\u4F1A\u505C\u4E0B\u3002"
  doorUnlocked: "\u9760\u8FD1\u5927\u95E8\uFF0C\u6309 F \u901A\u884C\u3002"
  doorCountFormat: "\u9700\u8981 {count} \u4E2A\u673A\u5173 \xB7 \u5F71\u5B50\u8E29\u4F4F\u673A\u5173"
  retryHint: "\u8FD8\u6CA1\u6210\u529F\uFF1F\u53EF\u70B9\u51FB\u201C\u91CD\u8BD5\u672C\u6B65\u201D\u3002"
  wrongType: "\u7C7B\u578B\u4E0D\u7B26\uFF0C\u6309\u5F53\u524D\u63D0\u793A\u518D\u8BD5\u4E00\u6B21\u3002"
  spikeRetry: "\u5F71\u5B50\u6CA1\u78B0\u5230\u5730\u523A\uFF0C\u8BF7\u91CD\u8BD5\u672C\u6B65\u3002"
  spikeResult: "\u5730\u523A\u4F1A\u6D88\u9664\u5F71\u5B50\uFF0C\u4E5F\u4F1A\u4F24\u5BB3\u4F60\u3002"
  doorResult: "\u6240\u6709\u5F71\u5B50\u5DF2\u6E05\u9664\uFF0C\u5927\u95E8\u6C38\u4E45\u5F00\u542F\u3002"
  retryResult: "\u5DF2\u56DE\u5230\u5B89\u5168\u7EC3\u4E60\u70B9\uFF0C\u8BF7\u518D\u8BD5\u4E00\u6B21\u3002"
  handbook: "\u64CD\u4F5C\u624B\u518C\n\nA / D \u79FB\u52A8\u3000Shift \u75BE\u884C\u3000\u7A7A\u683C\u8DF3\u8DC3\nE
    \u5F00\u59CB\u51C6\u5907\uFF1B\u51C6\u5907\u65F6\u518D\u6309\u53D6\u6D88\uFF0C\u8BB0\u5F55\u65F6\u518D\u6309\u7ED3\u675F\n\u9759\u6B62\u578B\uFF1A\u4E0D\u79FB\u52A8\u3000\u8D8B\u8FD1\u578B\uFF1A\u59CB\u7EC8\u540C\u5411\u79FB\u52A8\n\u8DDF\u968F\u578B\uFF1A\u79FB\u52A8\u540E\u505C\u4F4F\u3000\u907F\u8BA9\u578B\uFF1A\u6539\u53D8\u65B9\u5411\n\u8DDF\u968F\u578B\u54CD\u5E94\u4F60\u7684\u64CD\u4F5C\uFF0C\u4E0D\u4F1A\u81EA\u52A8\u5BFB\u8DEF\n\u6570\u5B57\u952E\u9009\u5F71\u5B50\u3000R
    \u6E05\u9664\u9009\u4E2D\u3000\u5FEB\u901F\u4E24\u6B21 R \u6E05\u9664\u5168\u90E8\n\u505C\u6B62\u7684\u8D8B\u8FD1\u578B\u5F71\u5B50\u53EF\u8E29\u8E0F\uFF1B\u5730\u523A\u4F1A\u6D88\u9664\u5F71\u5B50\n\u65D7\u5E1C\u673A\u5173\u63A7\u5236\u5927\u95E8\uFF0C\u6709\u4E9B\u9700\u8981\u4E24\u4E2A\u540C\u65F6\u6FC0\u6D3B\n\u89E3\u9501\u540E\u9760\u8FD1\u6309
    F\uFF1B\u9996\u6B21\u901A\u884C\u6E05\u9664\u5F71\u5B50\uFF0C\u5927\u95E8\u6C38\u4E45\u5F00\u542F\n\u8BA9\u5F71\u5B50\u89E6\u78B0\u8DEF\u706F\u5B58\u6863\uFF0C\u5DF2\u901A\u8FC7\u7684\u5927\u95E8\u4E5F\u4F1A\u4FDD\u5B58\nQ
    \u8FD4\u56DE\u83DC\u5355\uFF0C\u7EED\u884C\u6062\u590D\u8FDB\u5EA6\u3000H \u6682\u505C\n\u6EDA\u8F6E\u5411\u4E0B\u62C9\u8FDC\u3001\u5411\u4E0A\u62C9\u8FD1"
